# Copie ce fichier en « .env.local » (jamais envoyé sur GitHub) et remplis les valeurs.
# Sans ces deux lignes, le site tourne en mode démo avec de fausses données.

# Supabase → Project Settings → API (ou Connect)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=clé-publique-anon-ou-publishable

# Uniquement pour « npm run create-users » (ne la mets JAMAIS sur Netlify ni dans le code)
SUPABASE_SECRET_KEY=clé-secrète-service_role-ou-secret

# Sur Netlify uniquement (Site configuration → Environment variables), pour l'analyse IA :
# ANTHROPIC_API_KEY=sk-ant-...
